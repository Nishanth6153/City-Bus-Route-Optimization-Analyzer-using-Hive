# City Bus Route Optimization Analyzer - Environment Configuration Template
# Copy this file to .env and configure as needed.

# Application Server
FLASK_ENV=development
FLASK_PORT=8080
FRONTEND_PORT=8081

# Database Configuration (SQLite default; PostgreSQL/PostGIS optional for Docker)
DATABASE_TYPE=sqlite
DATABASE_PATH=backend/data/bus_routes.db

# PostgreSQL / PostGIS Settings (optional for Docker deployment)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=city_transit
POSTGRES_USER=transit_admin
POSTGRES_PASSWORD=your_secure_password_here

# Routing & Optimization Configuration
DEFAULT_OPTIMIZATION_MODE=balanced
MAX_ALTERNATIVE_ROUTES=3
CONGESTION_PENALTY_MULTIPLIER=1.5
